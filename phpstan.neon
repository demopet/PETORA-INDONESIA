includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app
        - bootstrap
        - config
        - database
        - modules
        - routes
    level: 5
    tmpDir: build/phpstan
    excludePaths:
        - bootstrap/cache (?)
        - storage (?)
    ignoreErrors:
        - identifier: trait.unused
          path: app/Models/Concerns/BelongsToBranch.php
        - identifier: method.childParameterType
          path: app/Models/Scopes/BranchScope.php
